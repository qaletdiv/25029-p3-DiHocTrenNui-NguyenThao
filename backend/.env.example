# Backend Server Configuration
PORT=5001

# JSON Web Token Secret Key
SECRET_KEY=your-jwt-secret-key-change-in-production

# Frontend Application URL (for CORS)
FRONTEND_URL=http://localhost:3000

# TiDB / MySQL Database Configuration
DB_HOST=gateway01.ap-northeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USERNAME=your_tidb_username
DB_PASSWORD=your_tidb_password
DB_SCHEMA=dhtn
DB_CONNECTION_LIMIT=10

# TLS / SSL Configuration (Optional: automatically enabled for tidbcloud.com)
# Set to 'true' or 'false' to override.
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true
# DB_CA=/path/to/isrgrootx1.pem

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Upload Configuration
MAX_FILE_SIZE_MB=5
